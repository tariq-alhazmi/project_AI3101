    "# Compare the three models on the same test set and with 5-fold cross-validation\n",
    "import numpy as np\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "from sklearn.model_selection import KFold, cross_val_score\n",
    "\n",
    "# Tahsili was scaled to 0-1, so multiplying an error by its original range turns it back into score points\n",
    "tahsili_range = scaler.data_range_[features.index('تحصيلي_1447')]\n",
    "\n",
    "models = {\n",
    "    'Linear Regression': model_lr,\n",
    "    'Random Forest': model_rf,\n",
    "    'XGBoost': model_xgb,\n",
    "}\n",
    "kfold = KFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "results = []\n",
    "for name, model in models.items():\n",
    "    y_pred = model.predict(X_test)\n",
    "    cv_r2 = cross_val_score(model, X, y, cv=kfold, scoring='r2')\n",
    "    results.append({\n",
    "        'Model': name,\n",
    "        'MAE (points)': mean_absolute_error(y_test, y_pred) * tahsili_range,\n",
    "        'RMSE (points)': np.sqrt(mean_squared_error(y_test, y_pred)) * tahsili_range,\n",
    "        'R2 (test set)': r2_score(y_test, y_pred),\n",
